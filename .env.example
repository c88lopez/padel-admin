# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Database ---
# No local database: `make run`, `make test` and `make test-e2e` set the
# database URLs themselves (padel_admin_dev and its test databases on the
# cluster's Postgres, through `make tunnel`). Only needed to run `bun run dev`
# directly:
#   postgres://padel_admin_dev:<password>@localhost:5433/padel_admin_dev
DATABASE_URL=

# --- Better Auth ---
# Secret used to sign sessions/cookies. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of the app (used for auth callbacks). Local dev default below.
BETTER_AUTH_URL=http://localhost:3003

# --- REST API ---
# Bearer token for the public REST API (e.g. /api/clubs). Server-to-server
# callers send `Authorization: Bearer <ADMIN_API_KEY>`. Leave empty to disable
# token auth (logged-in super-admin sessions still work). Generate one with:
#   openssl rand -base64 32
ADMIN_API_KEY=

# Bearer token for the hidden platform API (/api/platform/*), reserved for the
# app's owners (e.g. enabling activities for a club). Separate from
# ADMIN_API_KEY and never accepts a session. Requests without it get a 404, and
# leaving it empty disables the API. Generate one with:
#   openssl rand -base64 32
PLATFORM_API_KEY=

# --- AI Assistant ---
# Vercel AI Gateway key powering the AI assistant (/assistant). One key gives
# access to many models. Get one at https://vercel.com/ai-gateway. `make
# secrets` copies it into the cluster.
AI_GATEWAY_API_KEY=
# Optional: override the model (defaults to a cheap tool-calling model,
# openai/gpt-5-nano). Any AI Gateway model id works, e.g. openai/gpt-4o-mini,
# google/gemini-2.5-flash-lite, amazon/nova-lite, anthropic/claude-haiku-4.5.
AI_MODEL=
# Optional: override the voice transcription model (defaults to
# openai/gpt-4o-mini-transcribe). Any AI Gateway transcription model id works,
# e.g. openai/whisper-1.
AI_TRANSCRIPTION_MODEL=
# Optional but recommended: HMAC secret to cryptographically bind AI write
# approvals to the server that issued them. Generate one with:
#   openssl rand -base64 32
TOOL_APPROVAL_SECRET=
