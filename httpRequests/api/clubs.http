# Requests for the clubs endpoints of the hidden platform API (GET/POST
# /api/platform/clubs, GET/PATCH/DELETE /api/platform/clubs/:clubId), for the
# app's owners only. Pick an environment from the selector at the top of the
# editor: "local" (make tunnel, then make run, against padel_admin_dev) or "k8s"
# (the cluster's NodePort, against the real database).
#
# Hosts are in http-client.env.json. The key is a secret and differs per
# environment, so set it in http-client.private.env.json (gitignored):
#   {"local": {"platformApiKey": "…"}, "k8s": {"platformApiKey": "…"}}
# For k8s, the key is in the padel-admin-deps Secret:
#   kubectl -n padel-admin get secret padel-admin-deps -o jsonpath='{.data.PLATFORM_API_KEY}' | base64 -d
# For local, use the PLATFORM_API_KEY from .env. A missing or wrong key, or an
# unset one, makes every request a 404, so the API stays hidden.
#
# No request depends on another one's response: the club comes from {{clubId}}
# in the environment, so set it in http-client.private.env.json before running
# a request that needs it ("Create a club" logs the id it returns, or use an
# existing club). Deleting a club removes all of the club's data, and answers
# 409 while one of its members belongs to no other club: move them to another
# club or delete them first. Requests for the club's users are in users.http.

### List all clubs
GET {{host}}/api/platform/clubs
Authorization: Bearer {{platformApiKey}}

> {%
    client.test("returns 200 with a list of clubs", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(Array.isArray(response.body), "body is not an array");
    });
%}

### Create a club (also seeds its default activity, spaces and reservation rules)
POST {{host}}/api/platform/clubs
Authorization: Bearer {{platformApiKey}}
Content-Type: application/json

{
  "name": "{{clubName}}",
  "status": "active"
}

> {%
    client.test("returns 201 with the new club", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(typeof response.body.id === "string", "missing id");
        client.assert(response.body.status === "active", "club is not active");
    });
    client.log("clubId: " + response.body.id);
%}

### Get one club
GET {{host}}/api/platform/clubs/{{clubId}}
Authorization: Bearer {{platformApiKey}}

> {%
    client.test("returns 200 with the club", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.id === request.environment.get("clubId"), "wrong id");
    });
%}

### Rename a club (PATCH takes any subset of name and status)
PATCH {{host}}/api/platform/clubs/{{clubId}}
Authorization: Bearer {{platformApiKey}}
Content-Type: application/json

{
  "name": "{{clubName}} (renamed)"
}

> {%
    client.test("returns 200 with the new name", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.name.endsWith("(renamed)"), "name unchanged");
    });
%}

### Deactivate a club
PATCH {{host}}/api/platform/clubs/{{clubId}}
Authorization: Bearer {{platformApiKey}}
Content-Type: application/json

{
  "status": "inactive"
}

> {%
    client.test("returns 200 with the inactive club", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === "inactive", "club is still active");
    });
%}

### Delete a club (409 for the Default Club, and while a member has no other club)
DELETE {{host}}/api/platform/clubs/{{clubId}}
Authorization: Bearer {{platformApiKey}}

> {%
    client.test("returns 200 with the deleted id", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.id === request.environment.get("clubId"), "wrong id");
    });
%}

### Get the deleted club (404)
GET {{host}}/api/platform/clubs/{{clubId}}
Authorization: Bearer {{platformApiKey}}

> {%
    client.test("returns 404", () => {
        client.assert(response.status === 404, "status " + response.status);
    });
%}

### Without the platform key (404, as if the API didn't exist)
GET {{host}}/api/platform/clubs

> {%
    client.test("returns 404", () => {
        client.assert(response.status === 404, "status " + response.status);
    });
%}
